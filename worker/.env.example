# Railway worker environment. Set real values only in Railway Variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVER_SECRET
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TG_API_ID=YOUR_TELEGRAM_API_ID
TG_API_HASH=YOUR_TELEGRAM_API_HASH
TG_SESSION_STRING=YOUR_PYROGRAM_USER_SESSION_STRING
PORT=8787
HEARTBEAT_SECONDS=10
MAX_ROSTER=200
LOG_LEVEL=INFO
VOICE_WHEEL_URL=https://YOUR_PUBLIC_SITE/games/voice-wheel.html
# Comma-separated approved HTTPS hostnames for media playback.
# Leave empty to disable /play until a host is explicitly reviewed and allowlisted.
MEDIA_ALLOWED_HOSTS=
